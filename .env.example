# ==============================================================================
# Open Lecture Bank: Environment Configuration Template
# Copy this file to .env and configure local values as needed.
# ==============================================================================

# AI Provider Configuration (Modular: none, openai, gemini, anthropic, local_ollama)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_NAME=

# Local Pipeline Configuration
BATCH_SIZE=3
DATA_DIR=./data
LOG_LEVEL=INFO

# Feature Flags
ENABLE_OCR_FALLBACK=false
ENABLE_STREAMLIT_TELEMETRY=false
